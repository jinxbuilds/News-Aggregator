# Copy to .streamlit/secrets.toml. Every key is optional.
#
# No NEWS_API_KEY  -> app runs in demo mode with built-in sample articles.
# No AI key        -> summaries/briefing are hidden.
# Set either or both AI keys; you can switch provider in the sidebar.

NEWS_API_KEY = "your-newsapi-key-here"
ANTHROPIC_API_KEY = "your-anthropic-key-here"
GEMINI_API_KEY = "your-gemini-key-here"
